{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bardobard.example/schema/encounter.schema.json",
  "title": "Bardo Bard content file",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node" }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "act", "text", "a11y", "fallback"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "act": { "type": "integer", "minimum": 0, "maximum": 6 },
        "tally": {
          "type": "string",
          "description": "Ledger node key if this encounter is tallied (must be in the Compass §3 manifest)",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2", "D1", "D2", "D3", "E1", "F1", "V", "OMEGA"]
        },
        "terminal": {
          "type": "boolean",
          "description": "True for ending nodes; terminal nodes must have no choices"
        },
        "text": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base"],
          "properties": {
            "base": { "type": "string", "minLength": 1 },
            "fear": { "type": "string" },
            "curiosity": { "type": "string" },
            "reverence": { "type": "string" },
            "defiance": { "type": "string" }
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "goto"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "label": { "type": "string", "minLength": 1 },
              "state": {
                "type": "object",
                "additionalProperties": { "type": "number" }
              },
              "goto": { "type": "string" }
            }
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(TRADITION|INTERPRETATION|HYPOTHESIS|FICTION): "
          }
        },
        "a11y": { "type": "string", "minLength": 1 },
        "fallback": { "type": "string", "minLength": 1 }
      }
    }
  }
}
